# Copy this file to .env and replace the placeholder before starting Compose.
# .env is ignored by Git.
POSTGRES_DB=zapasli
POSTGRES_USER=zapasli
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_64_CHARACTER_VALUE
AUTH_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
AUTH_TOKEN_HASH_SECRET_BASE64=REPLACE_WITH_DIFFERENT_BASE64_OF_32_RANDOM_BYTES
AUTH_JWT_ISSUER=zapasli-backend
AUTH_JWT_AUDIENCE=zapasli-android
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
APP_VERSION=0.2.0-dev
GIT_COMMIT=local
